---
interface Props { current: string }
const { current } = Astro.props;
const tools = [
  { href: '/coffee-beans-1kg/', title: '원두 1kg 몇 잔?', desc: '며칠 가는지, 250g·500g·1kg 중 뭐가 맞는지', icon: 'bean' },
  { href: '/home-coffee-machine/', title: '가정용 커피머신 고르기', desc: '캡슐·전자동·반자동 3년 총비용 비교', icon: 'machine' },
  { href: '/nespresso-capsule/', title: '네스프레소 캡슐 고르기', desc: '정품 vs 호환 한 달 비용, 취향별 캡슐', icon: 'capsule' },
  { href: '/coffee-caffeine/', title: '커피 카페인 함량표', desc: '오늘 마신 커피, 하루 권고량의 몇 %일까', icon: 'bolt' },
  { href: '/office-coffee-cost/', title: '사무실 커피 비용', desc: '인원수로 원두·캡슐·카페 월 비용 비교', icon: 'office' },
].filter(t => t.href !== current);
---
<section class="related" aria-labelledby="rel-h">
  <h2 id="rel-h">다른 계산기도 써보세요</h2>
  <div class="rel-tiles">
    {tools.map(t => (
      <a class="rel-tile" href={t.href}>
        {t.icon === 'bean' && <svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="12" rx="6.5" ry="9" transform="rotate(30 12 12)"/><path d="M9 5.5c3 3 3 9 6 13"/></svg>}
        {t.icon === 'machine' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h14v5H5zM7 8v9M17 8v13H5v-4"/><path d="M9.5 13h4v3a2 2 0 0 1-2 2 2 2 0 0 1-2-2z"/></svg>}
        {t.icon === 'capsule' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M6 8l2 11h8l2-11M9 8V5h6v3"/></svg>}
        {t.icon === 'bolt' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3L5 14h6l-1 7 8-11h-6z"/></svg>}
        {t.icon === 'office' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="1.5"/><path d="M8 7h2M14 7h2M8 11h2M14 11h2M8 15h2M14 15h2M10 21v-3h4v3"/></svg>}
        <b>{t.title}</b><span>{t.desc}</span>
      </a>
    ))}
  </div>
</section>
<style>
  .related{margin:56px 0 0;padding:28px 20px;background:var(--band);border-radius:12px}
  .related h2{margin:0 0 16px}
  .rel-tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .rel-tile{display:flex;flex-direction:column;gap:6px;padding:18px;background:#fff;border:1px solid var(--line);border-radius:12px;text-decoration:none;color:var(--ink)}
  .rel-tile:hover{border-color:var(--espresso)}
  .rel-tile svg{width:28px;height:28px;fill:none;stroke:var(--espresso);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;margin-bottom:4px}
  .rel-tile b{font-size:var(--s3)}
  .rel-tile span{font-size:14px;line-height:1.5;color:var(--body)}
  @media (max-width:520px){.rel-tiles{grid-template-columns:1fr}}
</style>
