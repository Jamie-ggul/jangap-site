---
interface Props { eyebrow: string; title: string; img: string; imgM: string; credit?: string }
const { eyebrow, title, img, imgM } = Astro.props;
---
<section class="page-hero" aria-labelledby="page-h">
  <picture class="ph-img">
    <source media="(max-width: 720px)" srcset={imgM}>
    <img src={img} alt="" fetchpriority="high" decoding="async">
  </picture>
  <div class="ph-in">
    <p class="ph-eyebrow">{eyebrow}</p>
    <h1 id="page-h">{title}</h1>
  </div>
</section>
<style>
  .page-hero{position:relative;overflow:hidden;background:#1E140D;color:#fff}
  .ph-img,.ph-img img{position:absolute;inset:0;width:100%;height:100%}
  .ph-img img{object-fit:cover;object-position:center}
  .page-hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(20,13,8,.88) 0%,rgba(20,13,8,.72) 50%,rgba(20,13,8,.35) 100%)}
  .ph-in{position:relative;z-index:1;max-width:680px;margin:0 auto;padding:56px 20px 52px}
  .ph-eyebrow{margin:0 0 10px;font-size:14px;font-weight:700;color:#E8C9A8}
  .page-hero h1{margin:0;color:#fff;font-size:34px;line-height:1.3;letter-spacing:-.04em}
  @media (max-width:720px){
    .page-hero::after{background:linear-gradient(180deg,rgba(20,13,8,.80) 0%,rgba(20,13,8,.72) 100%)}
    .ph-in{padding:36px 20px 34px}
    .page-hero h1{font-size:26px}
  }
</style>
