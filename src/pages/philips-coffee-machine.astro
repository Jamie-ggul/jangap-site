---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import RelatedTools from '../components/RelatedTools.astro';
---
<Base ogImage="/img/og-philips-coffee-machine.jpg" title="필립스 커피머신 비교: 1200·2200·3300 라떼고 모델 차이와 고르는 법" description="필립스 커피머신은 시리즈 숫자와 우유 방식(스팀 노즐 vs 라떼고)만 보면 쉽게 골라요. 1200·2200·3300·5500 시리즈 메뉴 수와 우유 방식, 모델명 읽는 법, 라떼고 관리법까지 정리했어요." path="/philips-coffee-machine/" disclose="이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다. 추천은 판매 상품과 관계없이 같은 기준으로 나옵니다.">
  <PageHero slot="hero" eyebrow="커피머신 가이드" title="필립스 커피머신 비교: 시리즈별 차이 한눈에" img="/img/band-machine.webp" imgM="/img/band-machine-m.webp" />

  <p class="lead">필립스 커피머신은 대부분 원두를 넣고 버튼만 누르는 전자동이에요. 모델이 많아 보여도 두 가지만 보면 돼요. <b>시리즈 숫자</b>(1200·2200·3300…)와 <b>우유 방식</b>(스팀 노즐 vs 라떼고). 라떼를 얼마나 마시는지 고르면 맞는 필립스 커피머신을 알려드려요.</p>

  <section aria-label="조건 고르기">
    <p class="sentence">라떼는
      <span class="seg" role="group" aria-label="라떼 마시는 빈도"><button type="button" data-l="0" aria-pressed="false">거의 안 마셔요</button><button type="button" data-l="1" aria-pressed="true">가끔</button><button type="button" data-l="2" aria-pressed="false">자주</button></span>
    </p>
    <p class="sentence">우유 거품은
      <span class="seg" role="group" aria-label="우유 거품 내는 방식"><button type="button" data-f="hand" aria-pressed="true">직접 내도 돼요</button><button type="button" data-f="auto" aria-pressed="false">버튼 하나로</button></span>
    </p>
    <p class="sentence">메뉴는
      <span class="seg" role="group" aria-label="원하는 메뉴 수"><button type="button" data-m="few" aria-pressed="true">기본이면 돼요</button><button type="button" data-m="many" aria-pressed="false">다양하게</button></span>
    </p>
  </section>

  <section class="result" aria-labelledby="pick-h" aria-live="polite">
    <h2 id="pick-h">이런 필립스 커피머신이 맞아요</h2>
    <div class="apick">
      <p class="apick-main" id="pickMain"></p>
      <p class="apick-why" id="pickWhy"></p>
    </div>
    <div class="addon">
      <h3>조건에 맞는 모델</h3>
      <p class="addon-lead">조건을 바꾸면 목록도 바뀌어요.</p>
      <div id="pickItems">
        <a class="add-item has-img" data-g="steam froth" href="https://link.coupang.com/a/iFai58ZSjA" target="_blank" rel="sponsored nofollow noopener"><img class="th" src="https://thumbnail1.coupangcdn.com/thumbnails/remote/212x212ex/image/retail/images/544295556561283-54a33cd2-88b2-404c-8808-abad7d6a3744.png" alt="" width="56" height="56" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.parentNode.classList.remove('has-img');this.remove()"><span class="nm">필립스 2200 전자동 EP2224 <small>스팀 노즐 · 에스프레소·룽고 · 물통 1.8L</small></span><span class="pr">330,990원</span></a>
        <a class="add-item has-img" data-g="froth" href="https://link.coupang.com/a/iFkAg5ghhs" target="_blank" rel="sponsored nofollow noopener"><img class="th" src="https://thumbnail1.coupangcdn.com/thumbnails/remote/212x212ex/image/retail/images/86483452266729-b7c4e9be-3408-4cfa-a2b9-ea60cb909cbd.jpg" alt="" width="56" height="56" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.parentNode.classList.remove('has-img');this.remove()"><span class="nm">네스프레소 에어로치노 4 <small>따로 쓰는 자동 우유 거품기</small></span><span class="pr">109,000원</span></a>
        <div class="add-item soon" data-g="lg22" aria-disabled="true"><span class="nm">필립스 2200 라떼고 <small>라떼고 중 가장 기본 라인 · 상품 준비 중</small></span><span class="pr">준비 중</span></div>
        <a class="add-item has-img" data-g="lg22 lg33" href="https://link.coupang.com/a/iFalCjQkAm" target="_blank" rel="sponsored nofollow noopener"><img class="th" src="https://thumbnail1.coupangcdn.com/thumbnails/remote/212x212ex/image/vendor_inventory/1bf7/43e5ff94e7c2df9b4efed98dfb365de8deb7e59f47ef06514aad20dee4c0.jpg" alt="" width="56" height="56" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.parentNode.classList.remove('has-img');this.remove()"><span class="nm">필립스 3300 라떼고 EP3347 <small>라떼고 · 메뉴 6가지</small></span><span class="pr">508,180원</span></a>
        <div class="add-item soon" data-g="lg33" aria-disabled="true"><span class="nm">필립스 5500 라떼고 <small>메뉴 20가지 이상 · 상품 준비 중</small></span><span class="pr">준비 중</span></div>
      </div>
    </div>
    <p class="note">가격은 2026년 11월 14일 쿠팡 판매가이며 수시로 바뀌어요. 메뉴 수·우유 방식은 필립스 공식 페이지 기준이에요(하단 기준 참고).</p>
  </section>

  <section class="sec" aria-labelledby="line-h">
    <h2 id="line-h">필립스 전자동 커피머신 시리즈 비교</h2>
    <p>필립스 전자동 커피머신은 시리즈 숫자로 라인을 나눠요. 같은 시리즈 안에서도 우유 방식에 따라 모델이 갈려요.</p>
    <div class="tscroll">
      <table class="cmp">
        <thead><tr><th>시리즈</th><th>대표 모델</th><th>우유</th><th>메뉴</th></tr></thead>
        <tbody>
          <tr><td>1200</td><td>EP1220</td><td>스팀 노즐 (수동)</td><td>2가지</td></tr>
          <tr><td>2200</td><td>EP2220 · EP2224</td><td>스팀 노즐 (수동)</td><td>2가지 <small>(에스프레소·룽고)</small></td></tr>
          <tr><td>2200 라떼고</td><td>EP2230 · EP2231</td><td>라떼고 (자동)</td><td>모델마다 달라요</td></tr>
          <tr><td>3300</td><td>EP3326</td><td>스팀 노즐 (수동)</td><td>5가지</td></tr>
          <tr><td>3300 라떼고</td><td>EP3347</td><td>라떼고 (자동)</td><td>6가지</td></tr>
          <tr><td>5500 라떼고</td><td>EP5547</td><td>라떼고 (자동)</td><td>20가지 이상</td></tr>
        </tbody>
      </table>
    </div>
    <p class="note">메뉴 수는 필립스 미국·캐나다·홍콩 공식 페이지 표기예요. 5500은 판매 지역에 따라 20~22가지로 적혀 있어요. 한국 판매 모델은 사양이 조금 다를 수 있어 구매 전 상품 페이지를 꼭 확인해주세요.</p>
  </section>

  <section class="sec" aria-labelledby="code-h">
    <h2 id="code-h">필립스 커피머신 모델명 읽는 법</h2>
    <p>EP 뒤 앞 두 자리가 시리즈예요. EP<b>22</b>24는 2200 시리즈, EP<b>33</b>47은 3300 시리즈예요. 뒤에 붙는 /93, /90 같은 번호는 같은 모델 안의 세부 구분이에요. 한국 판매처에선 EP3347/93처럼 적혀 있어요.</p>
    <p class="sentence">모델명
      <span class="nw"><input class="fill code" id="code" type="text" value="EP3347" maxlength="12" autocomplete="off" spellcheck="false" aria-label="필립스 모델명">을</span> 풀어보면
    </p>
    <div class="insight">
      <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7z"/></svg></span>
      <span id="codeTip"></span>
    </div>
  </section>

  <section class="sec" aria-labelledby="milk-h">
    <h2 id="milk-h">필립스 라떼고 vs 스팀 노즐, 뭐가 달라요?</h2>
    <ul class="tips">
      <li><b>스팀 노즐 (클래식 우유 거품기)</b> 우유를 피처에 담아 노즐에 대고 직접 거품을 내요. 머신 값이 싸요. 라떼를 가끔 마신다면 충분해요.</li>
      <li><b>라떼고 (LatteGo)</b> 우유 통을 끼우고 버튼을 누르면 라떼·카푸치노가 바로 나와요. 관이 없는 구조라 필립스는 최소 10초 만에 씻을 수 있다고 안내해요.</li>
      <li><b>중간 선택지</b> 2200 스팀 모델에 따로 쓰는 자동 우유 거품기를 더하면, 라떼고 모델보다 적은 돈으로 버튼 하나로 거품을 낼 수 있어요.</li>
    </ul>
    <p class="note">드롱기 등 다른 브랜드까지 같이 보려면 <a href="/auto-coffee-machine/">전자동 커피머신 비교</a>를 참고하세요.</p>
  </section>

  <section class="sec" aria-labelledby="care-h">
    <h2 id="care-h">필립스 커피머신 관리법</h2>
    <ol class="check">
      <li><b>아쿠아클린 필터</b> 3300 라떼고는 머신 안내대로 필터를 8번 갈면 최대 5,000잔까지 석회 제거 없이 쓸 수 있다고 안내해요.</li>
      <li><b>추출부 헹구기</b> 필립스 2200은 추출부를 빼서 손으로 헹구고 윤활하도록 안내해요. 설명서 주기대로 챙겨주세요.</li>
      <li><b>우유 장치는 바로 세척</b> 라떼고든 스팀 노즐이든 우유가 남으면 굳어요. 쓰고 나서 바로 헹구는 게 가장 편해요.</li>
      <li><b>원두는 홀빈으로</b> 머신이 직접 갈기 때문에 분쇄 원두는 원두통에 넣지 마세요. 원두 고르기는 <a href="/coffee-bean-ranking/">커피 원두 추천 랭킹</a>에 정리했어요.</li>
    </ol>
  </section>

  <section class="sec" aria-labelledby="faq-h">
    <h2 id="faq-h">자주 묻는 질문</h2>
    <dl class="faq">
      <div><dt>필립스 커피머신 추천 모델은 뭐예요?</dt>
      <dd>라떼를 거의 안 마시거나 우유 거품을 직접 내도 된다면 2200 스팀 모델(EP2224)이 가장 부담이 적어요. 라떼를 버튼 하나로 마시고 싶다면 라떼고 모델(2200 라떼고·3300 라떼고)을 보세요.</dd></div>
      <div><dt>필립스 2200과 3300 차이는 뭐예요?</dt>
      <dd>가장 큰 차이는 메뉴 수예요. 공식 표기 기준으로 2200 스팀 모델은 2가지, 3300 라떼고(EP3347)는 6가지예요. 3300 라떼고는 이전 모델보다 소음이 40% 줄었다고 안내해요.</dd></div>
      <div><dt>필립스 라떼고는 세척이 어렵지 않아요?</dt>
      <dd>라떼고는 관 없이 통 몇 개로 된 구조라 흐르는 물에 헹구면 돼요. 필립스는 최소 10초면 씻을 수 있다고 안내해요.</dd></div>
      <div><dt>필립스 5400 시리즈는 아직 살 수 있어요?</dt>
      <dd>필립스코리아 고객지원 페이지에서 5400 시리즈(EP5447/93)는 단종으로 표시돼 있어요. 메뉴가 많은 상위 모델을 찾는다면 5500 시리즈 등 현재 판매 모델을 확인해보세요.</dd></div>
      <div><dt>필립스 커피머신 1잔 값은 얼마예요?</dt>
      <dd>원두 값에 따라 달라요. 원두 1kg 29,990원, 1잔 15g이면 1잔 약 450원이에요. 내 원두로 계산하려면 <a href="/auto-coffee-machine/">전자동 커피머신 비교</a>의 1잔 값 계산기를 써보세요.</dd></div>
    </dl>
  </section>

  <RelatedTools current="/philips-coffee-machine/" />

  <div class="src">
    기준 (2026년 11월 26일 확인)
    <ul>
      <li>시리즈별 메뉴 수·우유 방식: 필립스 미국 공식 커피 제품 목록(EP1220/04 2가지·클래식 우유 거품기, EP2220 2가지·클래식 우유 거품기, EP3326/90 5가지·클래식 우유 거품기, EP3347/90 6가지·라떼고), 필립스 캐나다 공식 목록(EP5547/90 20가지·라떼고), 필립스 홍콩 공식 목록(EP2230/10 라떼고, EP5547/90 22가지).</li>
      <li>3300 라떼고 EP3347: 라떼고 최소 10초 세척, 아쿠아클린 필터 8회 교체 기준 최대 5,000잔 석회 제거 불필요, 이전 모델 대비 소음 40% 감소: Philips 미국 공식 제품 페이지(EP3347/90).</li>
      <li>2200 EP2224: 에스프레소·룽고, 스팀 노즐, 물통 1.8L, 추출부 손 세척·윤활: Coolblue 제품 사양표(Philips 2200 EP2224/10, 11월 23일 확인).</li>
      <li>5400 시리즈 EP5447/93 단종 표시: 필립스코리아 고객지원 페이지. EP3347/93 한국 판매 표기: 하이마트 상품 페이지.</li>
      <li>1잔 값(원두 1kg 29,990원·1잔 15g): 잔값 다른 계산기와 같은 기준.</li>
      <li>쿠팡 상품 가격: 2026년 11월 14일 쿠팡 판매가.</li>
    </ul>
  </div>
  <p slot="credit">상단 사진: Zarak Khan / <a href="https://unsplash.com/" rel="noopener">Unsplash</a></p>
</Base>

<style is:global>
.sentence .seg{margin:4px 0}
.seg button{min-height:40px}
.sentence input.fill.code{width:5.6em;text-transform:uppercase}
.apick{padding:18px 20px;border:1px solid var(--espresso);border-radius:12px;background:var(--crema)}
.apick-main{margin:0;font-size:var(--s3);font-weight:700;color:var(--ink);line-height:1.5}
.apick-main b{color:var(--espresso)}
.apick-why{margin:8px 0 0;color:var(--body);font-size:15px;line-height:1.6}
#pickItems .add-item[hidden]{display:none}
.add-item.soon{color:var(--body);background:#fff;border-style:dashed;cursor:default}
.add-item.soon .pr{color:var(--muted);font-weight:700}
.tips{list-style:none;padding:0;margin:0}
.tips li{padding:14px 0;border-bottom:1px solid var(--hair);color:var(--body)}
.tips li:first-child{border-top:1px solid var(--hair)}
.tips li b{display:block;color:var(--ink);font-size:var(--s3);margin-bottom:2px}
.tscroll{overflow-x:auto}
table.cmp th,table.cmp td{text-align:left;vertical-align:top;font-size:15px;line-height:1.5;padding:12px 8px 12px 0}
table.cmp td{font-weight:400;color:var(--body)}
table.cmp td:first-child{font-weight:700;color:var(--ink);white-space:nowrap}
table.cmp td small{font-weight:400;color:var(--muted)}
</style>

<script is:inline>
const $=id=>document.getElementById(id);
let l=1,f='hand',m='few';
function bind(attr,set){document.querySelectorAll('['+attr+']').forEach(btn=>btn.onclick=()=>{set(btn.getAttribute(attr));document.querySelectorAll('['+attr+']').forEach(x=>x.setAttribute('aria-pressed',String(x===btn)));pick();});}
bind('data-l',v=>l=+v);bind('data-f',v=>f=v);bind('data-m',v=>m=v);
function pick(){
  let main,why,show;
  if(l===0||(f==='hand'&&m==='few')){
    main='<b>2200 스팀 모델</b>이면 충분해요.';
    why=l===0?'라떼를 거의 안 마시면 우유 장치에 돈을 더 쓸 필요가 없어요. 에스프레소·룽고를 버튼 하나로 내리면 돼요.':'우유 거품을 직접 내도 괜찮다면 스팀 노즐로 라떼까지 만들 수 있어요. 처음엔 거품 내는 데 연습이 조금 필요해요.';
    show=['steam'];
  }else if(f==='hand'){
    main='<b>2200 스팀 모델</b>로 시작해보세요.';
    why='메뉴가 많은 모델은 대부분 라떼고(자동 우유)가 함께 달려 나와요. 우유 거품을 직접 낼 거라면 기본 메뉴의 2200으로도 아메리카노·라떼를 다 만들 수 있어요.';
    show=['steam'];
  }else if(m==='few'){
    main=(l===2?'<b>라떼고 모델</b>을 추천해요.':'<b>라떼고 기본 라인</b>이나 <b>스팀 모델 + 우유 거품기</b>가 좋아요.');
    why=l===2?'라떼를 자주 마시면 우유 통을 끼우고 버튼만 누르는 라떼고가 편해요. 메뉴가 많지 않아도 된다면 2200 라떼고부터 보세요.':'라떼를 가끔 마신다면 2200 라떼고, 또는 2200 스팀 모델에 따로 쓰는 우유 거품기를 더하는 방법도 있어요. 둘을 합치면 40만 원대예요.';
    show=l===2?['lg22']:['lg22','froth'];
  }else{
    main='<b>3300 라떼고</b> 이상을 보세요.';
    why='메뉴를 다양하게 원한다면 6가지 메뉴의 3300 라떼고가 기준이에요. 더 많은 메뉴가 필요하면 20가지 이상인 5500 라떼고도 있어요.';
    show=['lg33'];
  }
  $('pickMain').innerHTML=main;$('pickWhy').textContent=why;
  document.querySelectorAll('#pickItems .add-item').forEach(el=>el.hidden=!el.dataset.g.split(' ').some(g=>show.includes(g)));
}
const known={
  EP1220:'1200 시리즈 · 스팀 노즐 · 메뉴 2가지',
  EP2220:'2200 시리즈 · 스팀 노즐 · 메뉴 2가지',
  EP2224:'2200 시리즈 · 스팀 노즐 · 에스프레소·룽고',
  EP2230:'2200 시리즈 · 라떼고',
  EP2231:'2200 시리즈 · 라떼고',
  EP3326:'3300 시리즈 · 스팀 노즐 · 메뉴 5가지',
  EP3347:'3300 시리즈 · 라떼고 · 메뉴 6가지',
  EP5447:'5400 시리즈 · 한국 고객지원 페이지에 단종 표시',
  EP5547:'5500 시리즈 · 라떼고 · 메뉴 20가지 이상'
};
function code(){
  const raw=$('code').value.toUpperCase().replace(/\s/g,'');
  const mm=raw.match(/^(EP)?(\d)(\d)(\d{2})/);
  if(!mm){$('codeTip').textContent='EP로 시작하는 모델명을 넣어주세요. 예: EP2224, EP3347/93';return;}
  const key='EP'+mm[2]+mm[3]+mm[4],series=mm[2]+mm[3]+'00';
  $('codeTip').innerHTML=known[key]?`<b>${key}</b> → ${known[key]}`:`<b>${key}</b>는 <b>${series} 시리즈</b>예요. 우유 방식은 상품명에 "라떼고"가 있는지 확인해보세요.`;
}
$('code').addEventListener('input',code);
pick();code();
</script>
