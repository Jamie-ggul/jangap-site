---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import RelatedTools from '../components/RelatedTools.astro';
---
<Base ogImage="/img/og-auto-coffee-machine.jpg" title="전자동 커피머신 비교: 필립스·드롱기 우유 방식·관리법·1잔 값" description="전자동 커피머신은 원두를 넣고 버튼만 누르면 분쇄부터 추출까지 알아서 해요. 라떼를 얼마나 마시는지, 우유 거품을 직접 낼지로 필립스·드롱기·제니퍼룸 전자동 커피머신을 비교하고 관리법과 1잔 값까지 정리했어요." path="/auto-coffee-machine/" disclose="이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다. 추천은 판매 상품과 관계없이 같은 기준으로 나옵니다.">
  <PageHero slot="hero" eyebrow="커피머신 가이드" title="전자동 커피머신 비교: 원두 넣으면 끝" img="/img/band-machine.webp" imgM="/img/band-machine-m.webp" />

  <p class="lead">전자동 커피머신은 원두를 통에 넣고 버튼만 누르면 분쇄, 담기, 추출까지 기계가 알아서 해요. 고를 때 가장 크게 갈리는 건 우유예요. 라떼를 얼마나 마시는지, 우유 거품을 직접 낼지만 고르면 맞는 전자동 커피머신을 골라드려요.</p>

  <section aria-label="조건 고르기">
    <p class="sentence">라떼는
      <span class="seg" role="group" aria-label="라떼 마시는 빈도"><button type="button" data-l="0" aria-pressed="false">거의 안 마셔요</button><button type="button" data-l="1" aria-pressed="true">가끔</button><button type="button" data-l="2" aria-pressed="false">자주</button></span>
    </p>
    <p class="sentence">우유 거품은
      <span class="seg" role="group" aria-label="우유 거품 내는 방식"><button type="button" data-f="hand" aria-pressed="true">직접 내도 돼요</button><button type="button" data-f="auto" aria-pressed="false">버튼 하나로</button></span>
    </p>
    <p class="sentence">예산은
      <span class="seg" role="group" aria-label="예산"><button type="button" data-b="low" aria-pressed="true"><span class="nw">35만 원</span> 안쪽</button><button type="button" data-b="high" aria-pressed="false"><span class="nw">50만 원대</span>까지</button></span>
    </p>
  </section>

  <section class="result" aria-labelledby="pick-h" aria-live="polite">
    <h2 id="pick-h">이런 전자동 커피머신이 맞아요</h2>
    <div class="apick">
      <p class="apick-main" id="pickMain"></p>
      <p class="apick-why" id="pickWhy"></p>
    </div>
    <div class="addon">
      <h3>조건에 맞는 머신</h3>
      <p class="addon-lead">조건을 바꾸면 목록도 바뀌어요.</p>
      <div id="pickItems">
        <a class="add-item" data-g="steam" href="https://link.coupang.com/a/iFai58ZSjA" target="_blank" rel="sponsored nofollow noopener"><span class="nm">필립스 2200 전자동 EP2224 <small>스팀 노즐 · 에스프레소·룽고 · 물통 1.8L</small></span><span class="pr">330,990원</span></a>
        <a class="add-item" data-g="steam" href="https://link.coupang.com/a/iFakmkDpHo" target="_blank" rel="sponsored nofollow noopener"><span class="nm">제니퍼룸 전자동 JR-EM0212 <small>세부 사양은 상품 페이지에서 확인</small></span><span class="pr">320,910원</span></a>
        <div class="add-item soon" data-g="steam"><span class="nm">드롱기 마그니피카 S ECAM22.110 <small>수동 우유 거품 장치 · 분쇄 13단계 · 물통 1.8L</small></span><span class="pr">준비 중</span></div>
        <a class="add-item" data-g="milk" href="https://link.coupang.com/a/iFalCjQkAm" target="_blank" rel="sponsored nofollow noopener"><span class="nm">필립스 3300 라떼고 EP3347 <small>우유 거품 자동 · 메뉴 6가지</small></span><span class="pr">508,180원</span></a>
        <a class="add-item" data-g="froth" href="https://link.coupang.com/a/iFkAg5ghhs" target="_blank" rel="sponsored nofollow noopener"><span class="nm">네스프레소 에어로치노 4 <small>따로 쓰는 자동 우유 거품기</small></span><span class="pr">109,000원</span></a>
      </div>
    </div>
    <p class="note">가격은 2026년 11월 14일 쿠팡 판매가이며 수시로 바뀌어요. 사양은 제조사 공개 자료 기준이에요(하단 기준 참고).</p>
  </section>

  <section class="sec" aria-labelledby="what-h">
    <h2 id="what-h">자동커피머신·원두커피머신, 전자동이랑 같은 말이에요?</h2>
    <p>검색할 때 섞어 쓰지만 조금씩 달라요. 핵심은 <b>원두를 누가 가느냐</b>예요.</p>
    <ul class="tips">
      <li><b>전자동 커피머신</b> 그라인더가 안에 있어서 원두를 넣고 버튼만 누르면 돼요. "자동커피머신"이라고 하면 보통 이걸 말해요.</li>
      <li><b>반자동 커피머신</b> 원두를 따로 갈아 포터필터에 담고 눌러 추출해요. 손이 가는 대신 맛을 직접 조절해요.</li>
      <li><b>캡슐 커피머신</b> 원두 대신 캡슐을 넣어요. 가장 간단하지만 1잔 값이 원두보다 비싸요.</li>
      <li><b>원두커피머신</b> 원두를 쓰는 머신을 넓게 부르는 말이에요. 전자동, 반자동, 드립 커피메이커가 다 들어가요.</li>
    </ul>
    <p class="note">캡슐·반자동·핸드드립까지 3년 총비용으로 비교하려면 <a href="/home-coffee-machine/">가정용 커피머신 고르기</a>를 써보세요.</p>
  </section>

  <section class="sec" aria-labelledby="cmp-h">
    <h2 id="cmp-h">전자동 커피머신 비교: 많이 팔리는 4가지</h2>
    <div class="tscroll">
      <table class="cmp">
        <thead><tr><th>모델</th><th>우유</th><th>메뉴</th><th>물통 · 원두통</th></tr></thead>
        <tbody>
          <tr><td>필립스 2200<br><small>EP2224</small></td><td>스팀 노즐 (수동)</td><td>에스프레소, 룽고</td><td>1.8L · 275g</td></tr>
          <tr><td>필립스 3300 라떼고<br><small>EP3347</small></td><td>라떼고 (자동)</td><td>6가지</td><td>제조사 표기 확인 필요</td></tr>
          <tr><td>드롱기 마그니피카 S<br><small>ECAM22.110</small></td><td>우유 거품 장치 (수동)</td><td>분쇄 13단계</td><td>1.8L · 250g</td></tr>
          <tr><td>제니퍼룸<br><small>JR-EM0212</small></td><td colspan="3">세부 사양은 판매 페이지에서 확인해주세요</td></tr>
        </tbody>
      </table>
    </div>
    <p class="note">필립스 2200·드롱기 마그니피카 S의 펌프 압력은 둘 다 15bar예요. 표의 값은 제조사·판매처 공개 사양 기준이에요.</p>
  </section>

  <section class="sec" aria-labelledby="milk-h">
    <h2 id="milk-h">전자동 커피머신 우유 거품, 수동 vs 자동</h2>
    <p>같은 전자동이라도 우유 거품 방식에 따라 가격이 크게 달라져요. 위 4가지 중 자동 우유 시스템이 있는 라떼고 모델만 50만 원대예요.</p>
    <ul class="tips">
      <li><b>수동 스팀 노즐·우유 거품 장치</b> 우유를 피처에 담아 노즐에 대고 직접 거품을 내요. 머신이 싸고 구조가 단순해요. 라떼를 가끔 마신다면 충분해요.</li>
      <li><b>자동 우유 시스템 (필립스 라떼고 등)</b> 우유 통을 끼우고 버튼을 누르면 라떼·카푸치노가 바로 나와요. 필립스는 라떼고를 10초 만에 세척할 수 있다고 안내해요.</li>
      <li><b>중간 선택지</b> 스팀형 전자동에 따로 쓰는 자동 우유 거품기를 더하면, 예산 안에서 버튼 하나로 거품을 낼 수 있어요.</li>
    </ul>
  </section>

  <section class="sec" aria-labelledby="dl-h">
    <h2 id="dl-h">드롱기 전자동 커피머신: 마그니피카 S</h2>
    <p>드롱기 전자동 커피머신 중 입문용으로 많이 찾는 모델이에요. 제조사 사양 기준으로 분쇄 굵기를 13단계로 바꿀 수 있고, 물통 1.8L, 원두통 250g, 펌프 압력 15bar예요. 추출부(브루 유닛)를 빼서 씻을 수 있고, 1회 원두 양은 6~14g 사이로 조절돼요. 우유는 수동 우유 거품 장치로 직접 내요.</p>
    <p class="note">드롱기 마그니피카 S 쿠팡 링크는 준비 중이에요.</p>
  </section>

  <section class="sec" aria-labelledby="care-h">
    <h2 id="care-h">가정용 원두커피머신 관리, 이것만 챙기세요</h2>
    <ol class="check">
      <li><b>석회 제거</b> 물속 석회가 쌓이면 맛과 고장에 영향을 줘요. 필립스 2200은 정수 필터(아쿠아클린)를 쓰면 6개월에 한 번, 3300 라떼고는 필터를 제때 갈면 최대 5,000잔까지 석회 제거 없이 쓸 수 있다고 안내해요.</li>
      <li><b>추출부 헹구기</b> 필립스 2200은 추출부를 손으로 헹구고 윤활하도록 안내하고, 드롱기 마그니피카 S도 추출부가 분리돼요. 설명서 주기대로 헹궈주세요.</li>
      <li><b>우유 장치는 바로 세척</b> 우유가 남으면 굳어서 거품이 잘 안 나요. 쓰고 나서 바로 헹구는 게 가장 편해요.</li>
      <li><b>원두는 조금씩</b> 원두통에 오래 두면 향이 빠져요. 며칠 안에 쓸 만큼만 채우세요. 보관법은 <a href="/coffee-beans-1kg/">원두 1kg 몇 잔?</a>에 정리했어요.</li>
    </ol>
  </section>

  <section class="sec" aria-labelledby="cost-h">
    <h2 id="cost-h">전자동 커피머신 1잔 값 계산</h2>
    <p class="sentence">
      하루 <span class="nw"><input class="fill" id="cups" type="number" min="0.5" step="0.5" value="2" inputmode="decimal" aria-label="하루 잔수">잔,</span>
      원두 1kg에 <span class="nw"><input class="fill w6" id="kg" type="number" min="0" step="1000" value="29990" inputmode="numeric" aria-label="원두 1kg 가격(원)">원,</span>
      1잔에 <span class="nw"><input class="fill" id="gram" type="number" min="5" max="30" value="15" inputmode="numeric" aria-label="1잔 원두(g)">g</span>
    </p>
    <div class="insight">
      <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7z"/></svg></span>
      <span id="costTip"></span>
    </div>
    <p class="note">캡슐은 호환 캡슐 1개 550원 기준이에요. 원두를 바꾸면 1잔 값이 달라져요. 원두별 1잔 값은 <a href="/coffee-bean-ranking/">커피 원두 추천 랭킹</a>에서 비교해보세요.</p>
  </section>

  <section class="sec" aria-labelledby="faq-h">
    <h2 id="faq-h">자주 묻는 질문</h2>
    <dl class="faq">
      <div><dt>전자동 커피머신과 자동커피머신은 다른 건가요?</dt>
      <dd>보통 같은 뜻으로 써요. 그라인더가 안에 있어서 원두를 넣고 버튼만 누르면 되는 머신이에요. 원두를 따로 갈아 담는 건 반자동이에요.</dd></div>
      <div><dt>드롱기 전자동 커피머신과 필립스 전자동, 뭐가 달라요?</dt>
      <dd>입문 모델끼리는 물통 1.8L, 펌프 압력 15bar로 기본 사양이 비슷해요. 드롱기 마그니피카 S는 분쇄 13단계와 1회 원두 양(6~14g) 조절을 내세우고, 필립스는 라떼고처럼 자동 우유 시스템이 달린 모델 선택지가 있어요. 라떼를 자주 마시는지로 고르면 쉬워요.</dd></div>
      <div><dt>가정용 원두커피머신, 캡슐 머신보다 이득인가요?</dt>
      <dd>머신은 더 비싸지만 1잔 값이 싸요. 원두 1kg 29,990원, 1잔 15g이면 1잔 약 450원이라 호환 캡슐(550원)보다 100원쯤 싸요. 하루 잔수가 많고 오래 쓸수록 유리해요. 3년 총비용은 <a href="/home-coffee-machine/">가정용 커피머신 고르기</a>에서 계산해보세요.</dd></div>
      <div><dt>전자동 커피머신에는 어떤 원두를 넣어야 해요?</dt>
      <dd>홀빈(갈지 않은 원두)을 넣어요. 머신이 직접 갈기 때문에 분쇄 원두는 원두통에 넣으면 안 돼요. 맛 취향별 원두는 <a href="/coffee-bean-types/">원두 종류별 맛 차이</a>를 참고하세요.</dd></div>
      <div><dt>라떼를 자주 마시는데 예산이 35만 원이에요.</dt>
      <dd>스팀형 전자동에 따로 쓰는 자동 우유 거품기를 더하는 방법이 있어요. 위 고르기에서 "자주 · 버튼 하나로 · 35만 원 안쪽"을 고르면 조합을 보여드려요.</dd></div>
    </dl>
  </section>

  <RelatedTools current="/auto-coffee-machine/" />

  <div class="src">
    기준 (2026년 11월 23일 확인)
    <ul>
      <li>필립스 2200 EP2224: 에스프레소·룽고, 스팀 노즐(수동), 세라믹 분쇄 디스크, 물통 1.8L, 원두통 275g, 15bar, 정수 필터 사용 시 석회 제거 6개월에 1번, 추출부 손 세척·윤활: Coolblue 제품 사양표(Philips 2200 EP2224/10).</li>
      <li>필립스 3300 라떼고 EP3347: 음료 6가지, 라떼고 최소 10초 세척, 아쿠아클린 사용 시 최대 5,000잔 석회 제거 불필요: Philips 미국 공식 제품 페이지(EP3347/90).</li>
      <li>드롱기 마그니피카 S ECAM22.110: 물통 1.8L, 원두통 250g, 15bar, 수동 우유 거품 장치: 드롱기 공식 제품 페이지. 분쇄 13단계, 분리형 추출부(1회 6~14g), 자동 헹굼·석회 제거 프로그램: 판매처 제조사 사양서(ECAM22110SB).</li>
      <li>원두 1kg 29,990원·1잔 15g, 호환 캡슐 1개 550원: 잔값 다른 계산기와 같은 기준(쿠팡 곰곰 콜롬비아 블렌드 1kg, 네스프레소 호환 캡슐 판매가).</li>
      <li>쿠팡 상품 가격: 2026년 11월 14일 쿠팡 판매가. 제니퍼룸 JR-EM0212 사양은 확인하지 못해 적지 않았어요.</li>
    </ul>
  </div>
  <p slot="credit">상단 사진: Zarak Khan / <a href="https://unsplash.com/" rel="noopener">Unsplash</a></p>
</Base>

<style is:global>
.sentence .seg{margin:4px 0}
.seg button{min-height:40px}
.sentence input.fill.w6{width:6.2em}
.apick{padding:18px 20px;border:1px solid var(--espresso);border-radius:12px;background:var(--crema)}
.apick-main{margin:0;font-size:var(--s3);font-weight:700;color:var(--ink);line-height:1.5}
.apick-main b{color:var(--espresso)}
.apick-why{margin:8px 0 0;color:var(--body);font-size:15px;line-height:1.6}
#pickItems .add-item[hidden]{display:none}
.add-item.soon{color:var(--body);background:#fff;border-style:dashed;cursor:default}
.add-item.soon .pr{color:var(--muted);font-weight:700}
.tips{list-style:none;padding:0;margin:0}
.tips li{padding:14px 0;border-bottom:1px solid var(--hair);color:var(--body)}
.tips li:first-child{border-top:1px solid var(--hair)}
.tips li b{display:block;color:var(--ink);font-size:var(--s3);margin-bottom:2px}
.tscroll{overflow-x:auto}
table.cmp th,table.cmp td{text-align:left;vertical-align:top;font-size:15px;line-height:1.5;padding:12px 8px 12px 0}
table.cmp td{font-weight:400;color:var(--body)}
table.cmp td:first-child{font-weight:700;color:var(--ink);white-space:nowrap}
table.cmp td small{font-weight:400;color:var(--muted)}
</style>

<script is:inline>
const $=id=>document.getElementById(id);
let l=1,f='hand',b='low';
function bind(attr,set){document.querySelectorAll('['+attr+']').forEach(btn=>btn.onclick=()=>{set(btn.getAttribute(attr));document.querySelectorAll('['+attr+']').forEach(x=>x.setAttribute('aria-pressed',String(x===btn)));pick();});}
bind('data-l',v=>l=+v);bind('data-f',v=>f=v);bind('data-b',v=>b=v);
function pick(){
  let main,why,show;
  if(l===0){
    main='<b>스팀형 입문 전자동</b>이면 충분해요.';
    why='라떼를 거의 안 마시면 우유 장치에 돈을 더 쓸 필요가 없어요. 30만 원대 모델로 아메리카노·에스프레소를 버튼 하나로 내리면 돼요.';
    show=['steam'];
  }else if(f==='hand'){
    main='<b>스팀 노즐이 달린 전자동</b>이 맞아요.';
    why='우유 거품을 직접 내도 괜찮다면 30만 원대 스팀형으로 라떼까지 만들 수 있어요. 처음엔 거품 내는 데 연습이 조금 필요해요.';
    show=['steam'];
  }else if(b==='high'){
    main='<b>자동 우유 시스템이 달린 전자동</b>을 추천해요.';
    why=(l===2?'라떼를 자주 마시고':'라떼를 가끔 마셔도')+' 버튼 하나로 끝내고 싶다면 우유 통을 끼우면 라떼가 바로 나오는 모델이 편해요. 위 4가지 중엔 필립스 라떼고가 50만 원대예요.';
    show=['milk'];
  }else{
    main='<b>스팀형 전자동 + 자동 우유 거품기</b> 조합이 좋아요.';
    why='자동 우유 시스템 모델은 50만 원대라 35만 원 안쪽에선 어려워요. 30만 원대 스팀형에 따로 쓰는 우유 거품기를 더하면 거품도 버튼 하나로 낼 수 있어요. 둘을 합치면 40만 원대예요.';
    show=['steam','froth'];
  }
  $('pickMain').innerHTML=main;$('pickWhy').textContent=why;
  document.querySelectorAll('#pickItems .add-item').forEach(el=>el.hidden=!show.includes(el.dataset.g));
}
const won=n=>Math.round(n).toLocaleString('ko-KR')+'원';
function cost(){
  const cups=Math.max(0,parseFloat($('cups').value)||0),kg=Math.max(0,parseFloat($('kg').value)||0),g=Math.max(0,parseFloat($('gram').value)||0);
  if(!cups||!kg||!g){$('costTip').textContent='하루 잔수, 원두 가격, 1잔 원두 양을 넣어주세요.';return;}
  const cup=kg/1000*g,month=cup*cups*30.4,cap=550*cups*30.4,diff=cap-month,days=1000/(g*cups);
  $('costTip').innerHTML=`1잔 원두값은 <b>${won(cup)}</b>, 한 달이면 <b>${won(month)}</b>이에요. 원두 1kg은 약 ${Math.floor(days)}일 가요.<br>`+
    (diff>0?`호환 캡슐로 마실 때보다 한 달에 ${won(diff)} 아껴요.`:`이 원두라면 호환 캡슐보다 한 달에 ${won(-diff)} 더 들어요.`);
}
['cups','kg','gram'].forEach(id=>$(id).addEventListener('input',cost));
pick();cost();
</script>
