<style is:global>
.seg button{min-height:40px}
.sentence .seg{margin:4px 0}
.tscroll{overflow-x:auto}
.mt th,.mt td{text-align:left;padding:12px 8px 12px 0;vertical-align:top;font-size:15px;line-height:1.5}
.mt td:first-child{white-space:nowrap}
.rec-lead{margin:0 0 12px;color:var(--body)}
.rec-lead b{color:var(--espresso)}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{font:inherit;font-size:15px;padding:8px 12px;min-height:40px;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--body);cursor:pointer}
.chip.rec{border-color:var(--espresso);color:var(--espresso);font-weight:700}
.chip.rec::before{content:"추천 ";font-size:12px;font-weight:700}
.chip[aria-pressed=true]{background:var(--espresso);border-color:var(--espresso);color:#fff;font-weight:700}
.viewer{display:grid;grid-template-columns:150px 1fr;gap:20px;align-items:center;margin-top:16px;padding:20px;border:1px solid var(--line);border-radius:12px;background:#fff}
.cup{width:150px;height:auto;display:block}
.vname{margin:0;font-size:var(--s4);line-height:1.3}
.vname small{font-size:var(--s1);color:var(--muted);font-weight:400}
.vrec{margin:6px 0 0;font-weight:700;color:var(--espresso);font-size:15px}
.vdesc{margin:8px 0 0;color:var(--body);font-size:15px;line-height:1.6}
.legend{list-style:none;padding:0;margin:12px 0 0;display:flex;flex-wrap:wrap;gap:6px 14px;font-size:var(--s1);color:var(--body)}
.legend i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:5px;vertical-align:-1px;border:1px solid rgba(0,0,0,.12)}
.tips{list-style:none;padding:0;margin:0}
.tips li{padding:14px 0;border-bottom:1px solid var(--hair);color:var(--body)}
.tips li:first-child{border-top:1px solid var(--hair)}
.tips li b{display:block;color:var(--ink);font-size:var(--s3);margin-bottom:2px}
@media (max-width:480px){.vname small{display:block}.viewer{grid-template-columns:96px 1fr;gap:14px;padding:16px}.cup{width:96px}.vname{font-size:19px}.chip{font-size:14px;padding:7px 11px}}
</style>

<script is:inline define:vars={{ menus, L }}>
const $=id=>document.getElementById(id);
const C={esp:'#3B2414',water:'#9C7A5B',milk:'#E6D3BA',foam:'#F7F0E6',syrup:'#E3B85C',caramel:'#B86E28',choco:'#5E3420',cream:'#FFFDF8',ice:'#F4E3BC'};
const REC={
 'none-plain':{t:'우유 없이 커피 그대로라면 <b>아메리카노</b>나 <b>에스프레소</b>예요.',k:['americano','espresso']},
 'none-sweet':{t:'우유 대신 크림이나 아이스크림으로 단맛을 내는 <b>아인슈페너</b>, <b>아포가토</b>를 추천해요.',k:['einspanner','affogato']},
 'little-plain':{t:'우유는 조금, 커피 맛은 진하게라면 <b>플랫화이트</b>, <b>코르타도</b>, <b>마키아또</b>예요.',k:['flatwhite','cortado','macchiato']},
 'little-sweet':{t:'진한 커피에 단맛을 살짝 더하려면 크림을 올린 <b>아인슈페너</b>가 잘 맞아요. 플랫화이트에 시럽을 조금 넣어도 좋아요.',k:['einspanner','flatwhite']},
 'lots-plain':{t:'우유 듬뿍, 부드러운 맛이라면 <b>카페라떼</b>, 거품을 좋아하면 <b>카푸치노</b>예요.',k:['latte','cappuccino']},
 'lots-sweet':{t:'달고 부드러운 커피라면 <b>바닐라라떼</b>, <b>카라멜 마키아또</b>, <b>카페모카</b>예요.',k:['vanilla','caramel','mocha']},
};
let m='lots',s='plain',cur='latte';
function cup(k){
  const x=menus.find(v=>v.k===k);
  const top=18,bot=133,h=bot-top;let y=bot,svg='';
  x.l.forEach(([t,p])=>{const lh=h*p/100;y-=lh;svg+=`<rect x="0" y="${y.toFixed(1)}" width="120" height="${(lh+0.5).toFixed(1)}" fill="${C[t]}"/>`;});
  $('cupLayers').innerHTML=svg;
  $('vName').textContent=x.n;$('vEn').textContent=x.e;$('vRec').textContent=x.r;$('vDesc').textContent=x.d;
  const seen=[];$('vLegend').innerHTML=[...x.l].reverse().filter(([t])=>!seen.includes(t)&&seen.push(t)).map(([t,p])=>`<li><i style="background:${C[t]}"></i>${L[t]}</li>`).join('');
  document.querySelectorAll('.chip').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.k===k)));
  cur=k;
}
function rec(){
  const r=REC[m+'-'+s];$('recLead').innerHTML=r.t;
  document.querySelectorAll('.chip').forEach(b=>b.classList.toggle('rec',r.k.includes(b.dataset.k)));
  cup(r.k[0]);
}
document.querySelectorAll('[data-m]').forEach(b=>b.onclick=()=>{m=b.dataset.m;document.querySelectorAll('[data-m]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));rec();});
document.querySelectorAll('[data-s]').forEach(b=>b.onclick=()=>{s=b.dataset.s;document.querySelectorAll('[data-s]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));rec();});
document.querySelectorAll('.chip').forEach(b=>b.onclick=()=>cup(b.dataset.k));
rec();
</script>
