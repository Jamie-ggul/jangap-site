---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import RelatedTools from '../components/RelatedTools.astro';
// 그림용 대략 비율(%). 아래쪽 층부터 순서대로. 수치 근거는 하단 "기준" 박스.
const menus = [
  { k: 'espresso', n: '에스프레소', e: 'Espresso', g: 'black', d: '곱게 간 원두에 뜨거운 물을 높은 압력으로 통과시켜 짧게 뽑은 진한 커피예요. 모든 메뉴의 바탕이 돼요.', r: '에스프레소만', l: [['esp', 100]] },
  { k: 'americano', n: '아메리카노', e: 'Americano', g: 'black', d: '에스프레소 1~2샷에 뜨거운 물을 부어 연하게 만든 커피예요. 한국에서 가장 많이 마시는 메뉴예요.', r: '에스프레소 + 물', l: [['esp', 22], ['water', 78]] },
  { k: 'macchiato', n: '에스프레소 마키아또', e: 'Macchiato', g: 'little', d: '에스프레소 1샷 위에 우유 거품을 한 숟갈 올린 작은 커피예요. 마키아또는 "얼룩"이라는 뜻이에요.', r: '에스프레소 + 우유 거품 조금', l: [['esp', 60], ['foam', 40]] },
  { k: 'cortado', n: '코르타도', e: 'Cortado', g: 'little', d: '에스프레소에 데운 우유를 비슷한 양만큼 섞은, 거품이 거의 없는 작은 잔 커피예요.', r: '에스프레소 + 데운 우유(거품 거의 없음)', l: [['esp', 40], ['milk', 60]] },
  { k: 'flatwhite', n: '플랫화이트', e: 'Flat White', g: 'little', d: '카푸치노와 같은 양의 에스프레소·우유를 쓰지만 거품을 얇게 올려 커피 맛이 더 진하게 느껴져요.', r: '에스프레소 + 우유 + 얇은 거품', l: [['esp', 25], ['milk', 65], ['foam', 10]] },
  { k: 'cappuccino', n: '카푸치노', e: 'Cappuccino', g: 'lots', d: '에스프레소, 데운 우유, 우유 거품을 비슷하게 나눈 커피예요. 라떼보다 거품이 두툼하고 잔이 작아요.', r: '에스프레소 + 우유 + 두꺼운 거품', l: [['esp', 20], ['milk', 40], ['foam', 40]] },
  { k: 'latte', n: '카페라떼', e: 'Caffè Latte', g: 'lots', d: '에스프레소에 데운 우유를 듬뿍 넣고 얇은 거품을 올린 커피예요. 우유 비율이 가장 높아 부드러워요.', r: '에스프레소 + 우유 듬뿍 + 얇은 거품', l: [['esp', 15], ['milk', 77], ['foam', 8]] },
  { k: 'vanilla', n: '바닐라라떼', e: 'Vanilla Latte', g: 'lots', s: true, d: '카페라떼에 바닐라 시럽을 넣어 달게 만든 커피예요.', r: '바닐라 시럽 + 에스프레소 + 우유 + 거품', l: [['syrup', 7], ['esp', 15], ['milk', 70], ['foam', 8]] },
  { k: 'caramel', n: '카라멜 마키아또', e: 'Caramel Macchiato', g: 'lots', s: true, d: '바닐라 시럽을 넣은 우유 위에 에스프레소를 붓고 카라멜 소스를 뿌려요. 에스프레소를 나중에 부어 층이 생겨요.', r: '바닐라 시럽 + 우유 + 에스프레소 + 카라멜', l: [['syrup', 7], ['milk', 62], ['esp', 17], ['foam', 8], ['caramel', 6]] },
  { k: 'mocha', n: '카페모카', e: 'Caffè Mocha', g: 'lots', s: true, d: '카페라떼에 초콜릿 소스를 넣고 휘핑크림을 올린 커피예요. 커피와 핫초코의 중간 맛이에요.', r: '초콜릿 + 에스프레소 + 우유 + 휘핑크림', l: [['choco', 10], ['esp', 15], ['milk', 55], ['cream', 20]] },
  { k: 'einspanner', n: '아인슈페너', e: 'Einspänner', g: 'none', s: true, d: '진한 커피 위에 휘핑크림을 두껍게 올린 오스트리아 빈 스타일 커피예요. 섞지 않고 크림 사이로 커피를 마셔요.', r: '진한 커피 + 휘핑크림', l: [['esp', 30], ['water', 35], ['cream', 35]] },
  { k: 'affogato', n: '아포가토', e: 'Affogato', g: 'none', s: true, d: '바닐라 아이스크림 위에 에스프레소를 부어 먹는 이탈리아 디저트예요. "빠진, 잠긴"이라는 뜻이에요.', r: '아이스크림 + 에스프레소', l: [['ice', 60], ['esp', 40]] },
];
const L: Record<string, string> = { esp: '에스프레소', water: '물', milk: '데운 우유', foam: '우유 거품', syrup: '바닐라 시럽', caramel: '카라멜 소스', choco: '초콜릿 소스', cream: '휘핑크림', ice: '아이스크림' };
---
<Base ogImage="/img/og-coffee-types.jpg" title="커피 종류: 메뉴별 에스프레소·우유 비율 한눈에 (라떼·카푸치노·플랫화이트)" description="커피 종류가 헷갈린다면 에스프레소, 우유, 거품 비율만 보면 돼요. 아메리카노·카페라떼·카푸치노·플랫화이트·마키아또 등 커피 메뉴 12가지를 컵 그림으로 비교하고 취향에 맞는 커피를 골라드려요." path="/coffee-types/" disclose="이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.">
  <PageHero slot="hero" eyebrow="커피 메뉴 가이드" title="커피 종류: 메뉴별 에스프레소·우유 비율 한눈에" img="/img/band-office.webp" imgM="/img/band-office-m.webp" />

  <p class="lead">커피 종류는 많아 보여도, 대부분 에스프레소에 무엇을 얼마나 더했는지의 차이예요. 물을 더하면 아메리카노, 우유를 더하면 라떼, 거품을 두껍게 올리면 카푸치노예요. 메뉴를 누르면 컵 속 비율을 그림으로 보여드려요.</p>

  <section aria-label="취향 고르기">
    <p class="sentence">
      우유는 <span class="seg" role="group" aria-label="우유 양"><button type="button" data-m="none" aria-pressed="false">안 넣고</button><button type="button" data-m="little" aria-pressed="false">조금</button><button type="button" data-m="lots" aria-pressed="true">듬뿍</button></span>,
      맛은 <span class="seg" role="group" aria-label="단맛"><button type="button" data-s="plain" aria-pressed="true">커피 그대로</button><button type="button" data-s="sweet" aria-pressed="false">달게</button></span>
      마시고 싶어요.
    </p>
  </section>

  <section class="result" aria-labelledby="pick-h">
    <h2 id="pick-h">추천 커피 메뉴</h2>
    <p class="rec-lead" id="recLead" aria-live="polite"></p>
    <div class="chips" role="group" aria-label="커피 메뉴 고르기">
      {menus.map(m => <button type="button" class="chip" data-k={m.k} aria-pressed="false">{m.n}</button>)}
    </div>
    <div class="viewer" aria-live="polite">
      <svg class="cup" viewBox="0 0 120 140" role="img" aria-labelledby="cupT">
        <title id="cupT">컵 속 비율 그림</title>
        <defs><clipPath id="cupClip"><path d="M14 18h92l-10 108a8 8 0 0 1-8 7H32a8 8 0 0 1-8-7z"/></clipPath></defs>
        <g clip-path="url(#cupClip)" id="cupLayers"></g>
        <path d="M14 18h92l-10 108a8 8 0 0 1-8 7H32a8 8 0 0 1-8-7z" fill="none" stroke="#46301E" stroke-width="2.5"/>
      </svg>
      <div class="vinfo">
        <p class="vname"><b id="vName"></b> <small id="vEn"></small></p>
        <p class="vrec" id="vRec"></p>
        <p class="vdesc" id="vDesc"></p>
        <ul class="legend" id="vLegend"></ul>
      </div>
    </div>
    <p class="note">그림은 메뉴 차이를 보여주는 대략적인 비율이에요. 실제 양은 카페와 잔 크기마다 달라요.</p>
  </section>

  <section class="sec" aria-labelledby="tbl-h">
    <h2 id="tbl-h">커피 종류별 비율 한눈에 보기</h2>
    <p>같은 에스프레소로 만들어도 물, 우유, 거품을 얼마나 넣느냐에 따라 이름이 달라져요. 진하기 순으로 정리했어요.</p>
    <div class="tscroll">
      <table class="mt">
        <thead><tr><th>메뉴</th><th>들어가는 것</th><th>맛</th></tr></thead>
        <tbody>
          <tr><td><b>에스프레소</b></td><td>원두 약 7g으로 약 25ml 추출 (이탈리아 기준)</td><td>가장 진하고 써요</td></tr>
          <tr><td><b>마키아또</b></td><td>에스프레소 1샷 + 우유 거품 조금, 약 60ml</td><td>진하지만 끝맛이 부드러워요</td></tr>
          <tr><td><b>코르타도</b></td><td>에스프레소 1샷 + 데운 우유 약 60ml</td><td>진함과 고소함의 반반</td></tr>
          <tr><td><b>플랫화이트</b></td><td>에스프레소 2샷 + 우유, 약 150~180ml, 얇은 거품</td><td>라떼보다 커피 맛이 진해요</td></tr>
          <tr><td><b>카푸치노</b></td><td>에스프레소 25ml + 우유 100ml(거품 내면 약 125ml)</td><td>폭신한 거품, 가벼운 질감</td></tr>
          <tr><td><b>카페라떼</b></td><td>에스프레소 + 우유 듬뿍, 약 240~360ml 이상</td><td>가장 부드럽고 고소해요</td></tr>
          <tr><td><b>아메리카노</b></td><td>에스프레소 1~2샷 + 뜨거운 물, 약 180~240ml</td><td>깔끔하고 가벼워요</td></tr>
        </tbody>
      </table>
    </div>
    <p class="note">ml은 해외 바리스타 가이드의 온스(oz) 기준을 환산한 값이에요(1oz ≈ 30ml). 한국 카페는 잔이 더 큰 경우가 많아요.</p>
  </section>

  <section class="sec" aria-labelledby="milk-h">
    <h2 id="milk-h">카페라떼 vs 카푸치노 vs 플랫화이트 차이</h2>
    <p>세 메뉴 모두 에스프레소와 우유로 만들어요. 차이는 우유 양과 거품 두께예요.</p>
    <ul class="tips">
      <li><b>카페라떼</b> 우유가 가장 많고 거품은 얇아요(약 0.5cm). 잔이 커서 커피 맛이 순해요.</li>
      <li><b>카푸치노</b> 잔이 작고 거품이 두꺼워요(1cm 이상). 첫 모금에 거품이 먼저 닿아요.</li>
      <li><b>플랫화이트</b> 카푸치노와 같은 크기에 거품만 라떼처럼 얇아요. 그래서 셋 중 커피 맛이 가장 진해요.</li>
    </ul>
  </section>

  <section class="sec" aria-labelledby="sweet-h">
    <h2 id="sweet-h">달달한 커피 종류: 바닐라라떼·카라멜 마키아또·카페모카</h2>
    <ul class="tips">
      <li><b>바닐라라떼</b> 카페라떼에 바닐라 시럽을 넣어요. 단맛 커피 입문용이에요.</li>
      <li><b>카라멜 마키아또</b> 바닐라 시럽 넣은 우유 위에 에스프레소를 붓고 카라멜을 뿌려요. 이름은 마키아또지만 사실상 달콤한 라떼예요.</li>
      <li><b>카페모카</b> 초콜릿 소스와 휘핑크림이 들어가요. 가장 디저트에 가까워요.</li>
      <li><b>아인슈페너</b> 진한 커피 위에 휘핑크림을 두툼하게 올려요. 크림을 섞지 않고 마시는 게 원래 방식이에요.</li>
    </ul>
  </section>

  <section class="sec" aria-labelledby="home-h">
    <h2 id="home-h">집에서 라떼·카푸치노 만들려면</h2>
    <p>에스프레소 대신 캡슐 커피나 진하게 내린 커피를 써도 돼요. 우유 거품만 있으면 카페라떼, 카푸치노, 플랫화이트를 다 만들 수 있어요. 거품을 두껍게 내면 카푸치노, 살짝만 내면 라떼예요.</p>
    <div class="addon">
      <h3>우유 거품기</h3>
      <p class="addon-lead">우유를 데워 거품을 내는 도구예요. 가격 순으로 골랐어요.</p>
      <a class="add-item" href="https://link.coupang.com/a/iFkBDJ3T4K" target="_blank" rel="sponsored nofollow noopener"><span class="nm">홈플래닛 핸디형 전동 우유거품기 <small>전동 · 건전지형 핸디 휘핑기</small></span><span class="pr">6,420원</span></a>
      <a class="add-item" href="https://link.coupang.com/a/iFkBlRWqUm" target="_blank" rel="sponsored nofollow noopener"><span class="nm">벨르디자인 스텐 이중망 우유거품기 M <small>수동 · 데운 우유를 펌프질해 거품</small></span><span class="pr">12,800원</span></a>
      <a class="add-item" href="https://link.coupang.com/a/iFkAg5ghhs" target="_blank" rel="sponsored nofollow noopener"><span class="nm">네스프레소 에어로치노 4 <small>자동 · 데우기와 거품을 버튼 하나로</small></span><span class="pr">109,000원</span></a>
    </div>
    <div class="addon">
      <h3>라떼용 원두</h3>
      <p class="addon-lead">우유에 묻히지 않는 진하고 고소한 블렌드예요.</p>
      <a class="add-item" href="https://link.coupang.com/a/iFkIVVP1CD" target="_blank" rel="sponsored nofollow noopener"><span class="nm">워너빈 카카오딥 블렌딩 <small>진한 블렌드 · 1kg</small></span><span class="pr">15,720원</span></a>
      <a class="add-item" href="https://link.coupang.com/a/iFkMnkeBH2" target="_blank" rel="sponsored nofollow noopener"><span class="nm">더써드로스터스 아몬드초콜릿 <small>산미 없는 고소한 블렌드 · 1kg</small></span><span class="pr">28,500원</span></a>
    </div>
    <p class="note">가격은 2026년 11월 14일 쿠팡 판매가이며 수시로 바뀌어요. 머신부터 고민이라면 <a href="/home-coffee-machine/">가정용 커피머신 고르기</a>를 먼저 보세요.</p>
  </section>

  <section class="sec" aria-labelledby="faq-h">
    <h2 id="faq-h">자주 묻는 질문</h2>
    <dl class="faq">
      <div><dt>카페라떼와 카푸치노 중 뭐가 더 진한가요?</dt>
      <dd>보통 카푸치노예요. 에스프레소 양은 비슷한데 카푸치노는 잔이 작고 우유가 적어서 커피 맛이 더 진하게 느껴져요. 부드러운 맛을 원하면 카페라떼를 고르세요.</dd></div>
      <div><dt>에스프레소 마키아또와 카라멜 마키아또는 같은 커피인가요?</dt>
      <dd>아니에요. 에스프레소 마키아또는 에스프레소에 우유 거품을 조금 얹은 작은 커피이고, 카라멜 마키아또는 바닐라 시럽과 우유가 많이 들어간 달콤한 라떼예요.</dd></div>
      <div><dt>커피 종류별로 카페인이 다른가요?</dt>
      <dd>카페인은 우유 양이 아니라 들어간 에스프레소 샷 수로 정해져요. 같은 카페라도 아메리카노가 라떼보다 샷이 많으면 카페인도 많아요. 메뉴별 수치는 <a href="/coffee-caffeine/">커피 카페인 함량표</a>에서 확인해보세요.</dd></div>
      <div><dt>플랫화이트는 라떼랑 뭐가 달라요?</dt>
      <dd>플랫화이트는 라떼보다 잔이 작고 우유가 적어요. 거품은 라떼처럼 얇아요. 그래서 라떼보다 커피 맛이 진하고, 카푸치노보다 질감이 매끈해요.</dd></div>
      <div><dt>라떼에는 어떤 원두가 잘 맞나요?</dt>
      <dd>산미가 적고 고소한 다크 로스팅 블렌드가 우유와 잘 어울려요. 취향별로 고르려면 <a href="/coffee-bean-types/">원두 종류별 맛 차이</a>를 참고하세요.</dd></div>
    </dl>
  </section>

  <RelatedTools current="/coffee-types/" />

  <div class="src">
    기준 (2026년 11월 18일 확인)
    <ul>
      <li>에스프레소(원두 7g±0.5, 25ml±2.5)와 카푸치노(에스프레소 25ml + 우유 100ml, 거품 내면 약 125ml, 150~160ml 잔): 이탈리아 에스프레소 협회(INEI) 인증 기준.</li>
      <li>아메리카노 6~8oz, 마키아또 약 2oz, 코르타도(1샷 + 우유 약 2oz), 카페라떼 8~12oz 이상, 카페모카 구성: Seattle Coffee Gear 에스프레소 메뉴 가이드.</li>
      <li>카푸치노·플랫화이트 5~6oz, 2샷(약 36~40g), 거품 두께(카푸치노 0.4인치 이상, 라떼·플랫화이트 약 0.2인치): Breville 블로그(SCA 정의 인용).</li>
      <li>카라멜 마키아또 구성(바닐라 시럽 우유 → 에스프레소 → 카라멜): Tasting Table의 스타벅스 레시피 설명.</li>
      <li>아인슈페너: 오스트리아 관광청 커피하우스 문화 소개. 아포가토: Wikipedia "Affogato".</li>
      <li>쿠팡 상품 가격: 2026년 11월 14일 쿠팡 판매가.</li>
    </ul>
